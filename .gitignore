# Backups automáticos feitos pelo próprio plugin a cada escrita — são
# artefato local de segurança, não fonte de verdade, não versiona.
_spade_backups/

# Dados de treino de tom — conteúdo privado de RP do usuário, não é código
# do plugin, não deveria ir num repositório (ainda mais se for público).
_dados/

# Caso algum dia entre alguma dependência de verdade
node_modules/

# Lixo comum de OS/editor
.DS_Store
*.log
